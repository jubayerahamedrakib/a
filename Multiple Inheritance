#include<iostream>
using namespace std;
class Father     // Base Class
{
private:
	void Property1()
	{
		cout << "This Property For Class Father" << endl;
	}
public:
	void ShowProperty1()
	{
		Property1();
	}
};

class Mother       // Base Class
{
private:
	void Property2()
	{
		cout << "This Property For Class Mother" << endl;
	}
public:
	void ShowProperty2()
	{
		Property2();
	}
};


class ExtraProperty    // Base Class
{
private:

	void ExtraProperty3()
	{
		cout << "This Property For Class Extra Property" << endl;
	}
public:
	void ShowExtraProperty3()
	{
		ExtraProperty3();
	}
};

class Child1 :public Father, public Mother    // Derive Class
{
public:
	void ShowPlay1()
	{
		cout << "Child play1" << endl;
	}
};

class Child2 :public Father, public Mother,public ExtraProperty         // Derive Class
{
public:
	void ShowPlay2()
	{
		cout << "Child play2" << endl;
	}
};

int main() 
{
	Child1 obj1;
	obj1.ShowProperty1();
	obj1.ShowProperty2();
	obj1.ShowPlay1();
	cout << endl;
	Child2 obj2;
	obj2.ShowProperty1();
	obj2.ShowProperty2();
	obj2.ShowExtraProperty3();
	obj2.ShowPlay2();
	return 0;
}
